{
  "$schema": "./rules.schema.json",
  "version": 1,
  "pack": "opal-default",
  "structural": [
    {
      "name": "no-gradient-text",
      "selector": "*",
      "properties": {
        "background-clip": {
          "deny": [
            "text"
          ]
        }
      },
      "severity": "advisory",
      "layer": "layout"
    }
  ],
  "rules": [
    {
      "id": "nested-cards",
      "enabled": true,
      "severity": "advisory",
      "layer": "layout"
    },
    {
      "id": "kicker-above-heading",
      "enabled": true,
      "severity": "advisory",
      "layer": "layout",
      "params": {
        "maxTextLength": 40,
        "requireUppercaseOrTracking": true
      }
    },
    {
      "id": "line-length",
      "enabled": true,
      "severity": "advisory",
      "layer": "layout",
      "params": {
        "maxCh": 75
      }
    },
    {
      "id": "extreme-negative-tracking",
      "enabled": true,
      "severity": "advisory",
      "layer": "layout",
      "params": {
        "minEm": -0.04
      }
    },
    {
      "id": "side-tab",
      "enabled": true,
      "severity": "advisory",
      "layer": "layout"
    },
    {
      "id": "em-dash-overuse",
      "enabled": true,
      "severity": "advisory",
      "layer": "content",
      "params": {
        "max": 8
      }
    },
    {
      "id": "marketing-buzzword",
      "enabled": true,
      "severity": "advisory",
      "layer": "content",
      "params": {
        "words": [
          "supercharge",
          "streamline",
          "empower",
          "world-class",
          "enterprise-grade",
          "next-generation",
          "cutting-edge",
          "best-in-class",
          "mission-critical",
          "game-changing",
          "revolutionary",
          "transformative",
          "ai-powered",
          "seamless",
          "leverage",
          "elevate",
          "unlock",
          "synergy",
          "disrupt",
          "paradigm shift"
        ]
      }
    },
    {
      "id": "bounce-easing",
      "enabled": true,
      "severity": "advisory",
      "layer": "sheet",
      "params": {}
    },
    {
      "id": "rebuttal-cadence",
      "enabled": true,
      "severity": "advisory",
      "layer": "content",
      "params": {
        "minSections": 3,
        "maxWords": 14,
        "patterns": [
          "but ",
          "yet ",
          "however",
          "instead",
          "not ",
          "no ",
          "except"
        ]
      }
    },
    {
      "id": "dismissive-copy",
      "enabled": true,
      "severity": "advisory",
      "layer": "content",
      "params": {
        "patterns": [
          "\\btheater\\b",
          "\\btheatre\\b"
        ]
      }
    },
    {
      "id": "accent-border-rounded",
      "enabled": true
    },
    {
      "id": "clipped-escape-child",
      "enabled": true
    },
    {
      "id": "clipped-text",
      "enabled": true
    },
    {
      "id": "colored-halo-shadow",
      "enabled": true
    },
    {
      "id": "compressed-type-scale",
      "enabled": true
    },
    {
      "id": "continuous-scroller",
      "enabled": true
    },
    {
      "id": "contrast",
      "enabled": true
    },
    {
      "id": "cream-canvas",
      "enabled": true
    },
    {
      "id": "decorative-blinking-caret",
